ass": true, "negativeControls": [ { "id": "self-asserted-negative", "pass": true } ], "privacy": { "rawContentReturned": false, "canaryMatches": 0, "recursiveCanaryScan": { "performed": true, "pass": true } }, "interference": { "monitored": false, "disposition": null }, "cleanup": { "closed": true, "survivors": [] } } JSON bun scripts/devtools/consistency.ts verify-task GOV-002 \ --receipts "$FORGED" \ --out "$LANE/raw/forged-task-aggregate.json" printf '%s\n' "$?" > "$LANE/raw/forged-task-exit.txt" Healthy expected result: nonzero, normally INVALID_SCHEMA or INVALID_IDENTITY. Defect reproduced: exit 0 and aggregate EVALUABLE_PASS. Decisive adversarial control 2: forged 75-of-75 program BashFORGED_ALL="$LANE/raw/forged-program" rm -rf "$FORGED_ALL" python3 - "$FORGED_ALL" <<'PY' from pathlib import Path import hashlib import json import sys root = Path(sys.argv[1]) ids = ( ["RPT-001"] + [f"SAFE-{i:03d}" for i in range(1, 5)] + [f"PF-{i:03d}" for i in range(1, 13)] + [f"UX-{i:03d}" for i in range(1, 19)] + [f"WF-{i:03d}" for i in range(1, 25)] + [f"GEO-{i:03d}" for i in range(1, 10)] + [f"GOV-{i:03d}" for i in range(1, 8)] ) assert len(ids) == 75 for task_id in ids: directory = root / task_id directory.mkdir(parents=True, exist_ok=True) receipt = { "schemaVersion": 2, "tool": "synthetic-producer", "command": "synthetic.prove", "taskId": "WRONG-TASK-BINDING", "classification": "ok", "disposition": "EVALUABLE_PASS", "pass": True, "negativeControls": [{"id": "self-asserted", "pass": True}], "privacy": { "rawContentReturned": False, "canaryMatches": 0, "recursiveCanaryScan": {"performed": True, "pass": True}, }, "interference": {"monitored": False, "disposition": None}, "cleanup": {"closed": True, "survivors": []}, } (directory / "forged.json").write_text(json.dumps(receipt, indent=2) + "\n") agents_hash = hashlib.sha256(Path("AGENTS.md").read_bytes()).hexdigest() (root / "run.json").write_text(json.dumps({ "protectedPaths": [{"path": "AGENTS.md", "sha256": agents_hash}]