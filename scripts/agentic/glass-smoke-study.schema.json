{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glass-smoke-study.schema.json",
  "title": "Glass smoke study manifest",
  "description": "Manifest-driven multi-build lifecycle study (glass-smoke-harness-max-info WP7). The orchestrator validates this shape, resolves every binary, computes every SHA, and writes a fully resolved immutable manifest before the fixture starts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "studyId", "profile", "builds", "design", "fixture"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "studyId": { "type": "string", "minLength": 1 },
    "profile": { "enum": ["full", "extended", "entry-color"] },
    "themeFixture": {
      "type": "string",
      "description": "Theme fixture path; defaults to the locked glass-motion calibration fixture."
    },
    "allowDuplicateBinarySha": {
      "type": "boolean",
      "description": "Permit deliberate A/A controls. Without this, duplicate binary SHAs are rejected as accidental mislabeled rungs."
    },
    "builds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "binary", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["baseline", "candidate", "negative-control"] },
          "binary": { "type": "string", "minLength": 1 },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["morphStartAlpha"],
            "properties": {
              "morphStartAlpha": { "type": "number", "minimum": 0, "maximum": 1 },
              "morphStartAlphaBits": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$",
                "description": "Optional f64 bits (canonical form; the runtime logs f64 to_bits). When present it must equal the bits of morphStartAlpha."
              },
              "settleDurationNs": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "warmupsPerBuild", "requiredBlocks", "failureOnlyEarlyStop"],
      "properties": {
        "type": { "const": "mirrored-cyclic" },
        "warmupsPerBuild": {
          "type": "integer",
          "minimum": 3,
          "description": "Conservative 3 in the first v2 implementation; never automatically reduced below 3."
        },
        "requiredBlocks": { "type": "integer", "minimum": 1 },
        "failureOnlyEarlyStop": { "type": "boolean" },
        "maxBlockRetries": { "type": "integer", "minimum": 0 }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["saturated-stripes", "dark-terminal", "light-document", "material-matched"] }
      }
    }
  }
}
